// ============================================================
// SCHEMA PRISMA — Sistema de Transporte Público
// Versión 4 — Santa Cruz de la Sierra, Bolivia
// Incluye: journey planning, transbordos, incidentes, IA, métricas
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Role {
  CITIZEN
  ADMIN
  DRIVER
  SUPERADMIN
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TripEndReason {
  COMPLETED_NORMAL
  DRIVER_BREAK
  DRIVER_SHIFT_END
  INCIDENT
  ADMIN_FORCED
}

enum CredentialStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum TerminalType {
  GARAGE
  TERMINAL
  STOP_POINT
}

enum FavoriteType {
  LINE
  STOP
  ROUTE
}

enum NotificationType {
  SYSTEM
  LINE_UPDATE
  TRIP_ALERT
  TRANSFER_ALERT
  DRIVER_INSTRUCTION
  ANNOUNCEMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum IncidentType {
  ACCIDENT
  MECHANICAL
  HEALTH
  PERSONAL
  ROUTE_BLOCKED
  OTHER
}

enum IncidentStatus {
  PENDING
  APPROVED
  REJECTED
  RESOLVED
}

enum TransferStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
  COMPLETED
}

enum JourneyCriteria {
  FASTEST
  LESS_WALKING
  LESS_TRANSFERS
}

enum TrafficSeverity {
  LOW
  MEDIUM
  HIGH
}

enum TrafficSource {
  GPS_DATA
  USER_REPORT
  EXTERNAL
}

// ------------------------------------------------------------
// USUARIOS Y AUTENTICACIÓN
// ------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  name         String
  phone        String?
  avatarUrl    String?
  birthDate    DateTime?
  role         Role      @default(CITIZEN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  createdById  String?
  createdBy    User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]    @relation("UserCreatedBy")

  managedLine  BusLine?  @relation("LineAdmin")
  driver       Driver?

  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  savedJourneys SavedJourney[]
  journeyPlans  JourneyPlan[]
  preference    UserPreference?

  notificationsReceived  NotificationReceipt[] @relation("NotificationReceiver")
  notificationsCreated   Notification[]        @relation("NotificationCreator")
  notificationsTargeted  Notification[]        @relation("NotificationTarget")

  incidentsReviewed  Incident[]        @relation("IncidentReviewer")
  assignmentsMade    DailyAssignment[] @relation("AssignmentAdmin")
  transfersDecided   InternoTransfer[] @relation("TransferDecider")

  auditLogs    AuditLog[]

  @@index([deletedAt])
  @@index([role])
  @@map("users")
}

// ------------------------------------------------------------
// CUENTAS OAUTH
// ------------------------------------------------------------

model OAuthAccount {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])

  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ------------------------------------------------------------
// REFRESH TOKENS
// ------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])

  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------
// LÍNEAS DE BUS
// ------------------------------------------------------------

model BusLine {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  description String?
  color       String    @default("#FF0000")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  adminId     String    @unique
  admin       User      @relation("LineAdmin", fields: [adminId], references: [id])

  internos    Interno[]
  routes      Route[]
  drivers     Driver[]
  terminals   Terminal[]

  @@index([deletedAt])
  @@map("bus_lines")
}

// ------------------------------------------------------------
// TERMINALES Y GARAJES
// ------------------------------------------------------------

model Terminal {
  id        String       @id @default(uuid())
  name      String
  type      TerminalType
  latitude  Float
  longitude Float
  address   String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  busLineId String?
  busLine   BusLine?     @relation(fields: [busLineId], references: [id])

  @@index([busLineId])
  @@index([deletedAt])
  @@map("terminals")
}

// ------------------------------------------------------------
// INTERNOS (vehículos)
// ------------------------------------------------------------

model Interno {
  id          String    @id @default(uuid())
  busLineId   String
  busLine     BusLine   @relation(fields: [busLineId], references: [id])

  number      Int
  plateNumber String?   @unique
  model       String?
  capacity    Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  shifts            Shift[]
  trips             Trip[]
  dailyAssignments  DailyAssignment[]

  @@unique([busLineId, number])
  @@index([deletedAt])
  @@map("internos")
}

// ------------------------------------------------------------
// CHOFERES
// ------------------------------------------------------------

model Driver {
  id               String           @id @default(uuid())

  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])

  busLineId        String
  busLine          BusLine          @relation(fields: [busLineId], references: [id])

  licenseNumber    String?          @unique
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  credentialStatus CredentialStatus @default(PENDING)
  lastLoginAt      DateTime?
  isTracking       Boolean          @default(false)

  shifts           Shift[]
  trips            Trip[]
  incidents        Incident[]

  @@index([deletedAt])
  @@map("drivers")
}

// ------------------------------------------------------------
// TURNOS
// ------------------------------------------------------------

model Shift {
  id        String    @id @default(uuid())

  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id])

  internoId String
  interno   Interno   @relation(fields: [internoId], references: [id])

  routeId   String
  route     Route     @relation(fields: [routeId], references: [id])

  daysOfWeek Json     @default("[]")
  startTime String
  endTime   String

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([driverId])
  @@index([internoId])
  @@index([deletedAt])
  @@map("shifts")
}

// ------------------------------------------------------------
// ASIGNACIÓN DIARIA
// ------------------------------------------------------------

model DailyAssignment {
  id           String    @id @default(uuid())

  date         DateTime
  internoId    String
  interno      Interno   @relation(fields: [internoId], references: [id])

  routeId      String
  route        Route     @relation(fields: [routeId], references: [id])

  assignedById String?
  assignedBy   User?     @relation("AssignmentAdmin", fields: [assignedById], references: [id])

  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trips        Trip[]

  @@unique([date, internoId])
  @@index([date])
  @@index([routeId])
  @@map("daily_assignments")
}

// ------------------------------------------------------------
// RUTAS
// ------------------------------------------------------------

model Route {
  id              String    @id @default(uuid())
  busLineId       String
  busLine         BusLine   @relation(fields: [busLineId], references: [id])

  name            String
  importedFileUrl String?
  importedAt      DateTime?
  waypoints       Json      @default("[]")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  lastEditedById  String?

  routeStops        RouteStop[]
  routeSegments     RouteSegment[]
  trips             Trip[]
  shifts            Shift[]
  dailyAssignments  DailyAssignment[]
  fares             Fare[]

  @@index([deletedAt])
  @@map("routes")
}

// ------------------------------------------------------------
// TARIFAS
// ------------------------------------------------------------

model Fare {
  id            String   @id @default(uuid())
  routeId       String
  route         Route    @relation(fields: [routeId], references: [id])
  amount        Float
  currency      String   @default("BOB")
  passengerType String   @default("ADULT")
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([routeId])
  @@index([isActive])
  @@map("fares")
}

// ------------------------------------------------------------
// PARADAS
// ------------------------------------------------------------

model Stop {
  id        String     @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  routeStops      RouteStop[]
  transfers       InternoTransfer[]
  segmentsFrom    RouteSegment[]    @relation("SegmentFrom")
  segmentsTo      RouteSegment[]    @relation("SegmentTo")

  @@index([latitude, longitude])
  @@index([deletedAt])
  @@map("stops")
}

// ------------------------------------------------------------
// ROUTE_STOP
// ------------------------------------------------------------

model RouteStop {
  id         String  @id @default(uuid())
  routeId    String
  route      Route   @relation(fields: [routeId], references: [id])

  stopId     String
  stop       Stop    @relation(fields: [stopId], references: [id])

  orderIndex                Int
  estimatedMinutesFromStart Int?

  @@unique([routeId, orderIndex])
  @@unique([routeId, stopId])
  @@index([stopId])
  @@map("route_stops")
}

// ------------------------------------------------------------
// VIAJES GUARDADOS POR EL USUARIO
// ------------------------------------------------------------

model SavedJourney {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  alias     String

  fromLat   Float
  fromLng   Float
  fromLabel String?
  toLat     Float
  toLng     Float
  toLabel   String?

  lastResult       Json?
  lastCalculatedAt DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_journeys")
}

// ------------------------------------------------------------
// PLAN DE VIAJE CALCULADO (caché)
// ------------------------------------------------------------

model JourneyPlan {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  fromLat   Float
  fromLng   Float
  toLat     Float
  toLng     Float

  // Criterio usado al calcular
  criteria  JourneyCriteria @default(FASTEST)

  segments         Json
  totalMinutes     Int
  totalTransfers   Int
  totalWalkMeters  Float

  // Si la IA evaluó este plan
  aiScore          Float?
  aiRecommendation String?

  computedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId, computedAt])
  @@index([fromLat, fromLng, toLat, toLng])
  @@map("journey_plans")
}



// ------------------------------------------------------------
// NOTIFICACIONES
// ------------------------------------------------------------

model Notification {
  id           String           @id @default(uuid())
  title        String
  body         String
  content      String?
  type         NotificationType
  data         Json?

  targetRole   Role?
  targetUserId String?
  targetUser   User?            @relation("NotificationTarget", fields: [targetUserId], references: [id])

  createdById  String?
  createdBy    User?            @relation("NotificationCreator", fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  expiresAt    DateTime?

  receipts     NotificationReceipt[]

  @@index([targetRole])
  @@index([createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------
// RECEIPTS DE NOTIFICACIONES
// ------------------------------------------------------------

model NotificationReceipt {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])

  userId         String
  user           User         @relation("NotificationReceiver", fields: [userId], references: [id])

  sentAt         DateTime     @default(now())
  readAt         DateTime?
  pushSent       Boolean      @default(false)
  pushToken      String?

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_receipts")
}

// ------------------------------------------------------------
// VIAJES (Trip)
// ------------------------------------------------------------

model Trip {
  id        String     @id @default(uuid())

  driverId  String
  driver    Driver     @relation(fields: [driverId], references: [id])

  internoId String
  interno   Interno    @relation(fields: [internoId], references: [id])

  routeId   String
  route     Route      @relation(fields: [routeId], references: [id])

  dailyAssignmentId String?
  dailyAssignment   DailyAssignment? @relation(fields: [dailyAssignmentId], references: [id])

  status                   TripStatus     @default(ACTIVE)
  endReason                TripEndReason?
  estimatedDurationMinutes Int?

  startedAt DateTime   @default(now())
  endedAt   DateTime?

  locations    DriverLocation[]
  deviations   RouteDeviation[]
  incidents    Incident[]

  transferFrom InternoTransfer? @relation("TransferFrom")
  transferTo   InternoTransfer? @relation("TransferTo")

  @@index([routeId, status])
  @@index([internoId, startedAt])
  @@map("trips")
}

// ------------------------------------------------------------
// UBICACIONES EN TIEMPO REAL
// ------------------------------------------------------------

model DriverLocation {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id])

  latitude   Float
  longitude  Float
  heading    Float?
  speed      Float?

  recordedAt DateTime @default(now())

  @@index([tripId, recordedAt(sort: Desc)])
  @@index([latitude, longitude])
  @@map("driver_locations")
}

// ------------------------------------------------------------
// DESVÍOS DE RUTA
// ------------------------------------------------------------

model RouteDeviation {
  id           String   @id @default(uuid())
  tripId       String
  trip         Trip     @relation(fields: [tripId], references: [id])

  latitude     Float
  longitude    Float
  distanceM    Float

  detectedAt   DateTime @default(now())
  reviewedById String?
  reviewedAt   DateTime?

  @@index([tripId])
  @@map("route_deviations")
}

// ------------------------------------------------------------
// INCIDENTES (reportes del chofer)
// ------------------------------------------------------------

model Incident {
  id          String         @id @default(uuid())

  driverId    String
  driver      Driver         @relation(fields: [driverId], references: [id])

  tripId      String?
  trip        Trip?          @relation(fields: [tripId], references: [id])

  type        IncidentType
  status      IncidentStatus @default(PENDING)
  description String?

  latitude    Float?
  longitude   Float?

  requestStopTracking Boolean @default(false)
  trackingStopped     Boolean @default(false)

  reviewedById String?
  reviewedBy   User?    @relation("IncidentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?

  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([driverId])
  @@index([status])
  @@index([reportedAt])
  @@map("incidents")
}

// ------------------------------------------------------------
// TRASBORDO ENTRE INTERNOS
// ------------------------------------------------------------

model InternoTransfer {
  id          String         @id @default(uuid())

  fromTripId  String         @unique
  fromTrip    Trip           @relation("TransferFrom", fields: [fromTripId], references: [id])

  toTripId    String?        @unique
  toTrip      Trip?          @relation("TransferTo", fields: [toTripId], references: [id])

  stopId      String?
  stop        Stop?          @relation(fields: [stopId], references: [id])
  latitude    Float
  longitude   Float

  status      TransferStatus @default(SUGGESTED)
  reason      String?

  decidedById String?
  decidedBy   User?          @relation("TransferDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  suggestedAt DateTime       @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([fromTripId])
  @@map("interno_transfers")
}

// ============================================================
// MÓDULO DE IA Y MÉTRICAS
// ============================================================

// ------------------------------------------------------------
// SEGMENTOS DE RUTA (entre dos paradas consecutivas)
// Para cálculo de ETA y análisis de tráfico
// ------------------------------------------------------------

model RouteSegment {
  id             String  @id @default(uuid())
  routeId        String
  route          Route   @relation(fields: [routeId], references: [id])

  fromStopId     String
  fromStop       Stop    @relation("SegmentFrom", fields: [fromStopId], references: [id])
  toStopId       String
  toStop         Stop    @relation("SegmentTo", fields: [toStopId], references: [id])

  distanceMeters Float

  travelTimes    SegmentTravelTime[]

  @@unique([routeId, fromStopId, toStopId])
  @@index([routeId])
  @@map("route_segments")
}

// ------------------------------------------------------------
// TIEMPOS HISTÓRICOS POR TRAMO, DÍA Y HORA
// Esta es la tabla CLAVE para predecir ETA con tráfico
// ------------------------------------------------------------

model SegmentTravelTime {
  id            String       @id @default(uuid())
  segmentId     String
  segment       RouteSegment @relation(fields: [segmentId], references: [id])

  dayOfWeek     Int
  hourOfDay     Int

  avgMinutes    Float
  avgSpeedKmh   Float
  sampleCount   Int          @default(0)
  lastUpdatedAt DateTime     @updatedAt

  @@unique([segmentId, dayOfWeek, hourOfDay])
  @@index([segmentId])
  @@map("segment_travel_times")
}

// ------------------------------------------------------------
// CONDICIONES DE TRÁFICO DETECTADAS
// Detección de congestión proactiva
// ------------------------------------------------------------

model TrafficCondition {
  id         String          @id @default(uuid())

  centerLat  Float
  centerLng  Float
  radiusM    Float

  severity   TrafficSeverity
  source     TrafficSource

  affectedRouteId String?
  description     String?

  detectedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([centerLat, centerLng])
  @@index([expiresAt])
  @@index([severity])
  @@map("traffic_conditions")
}

// ------------------------------------------------------------
// PREFERENCIAS DEL USUARIO
// El sistema aprende patrones para mejorar sugerencias
// ------------------------------------------------------------

model UserPreference {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id])

  preferredCriteria JourneyCriteria @default(FASTEST)
  maxWalkMeters     Int             @default(500)
  maxTransfers      Int             @default(2)

  // Patrones aprendidos del comportamiento del usuario
  // { frequentRoutes: [...], usualTimes: [...], commonOrigins: [...] }
  learnedPatterns   Json?

  updatedAt         DateTime        @updatedAt

  @@map("user_preferences")
}

// ------------------------------------------------------------
// PREDICCIONES DE IA (caché)
// ------------------------------------------------------------

model AIPrediction {
  id           String   @id @default(uuid())

  type         String                       // "ETA" | "TRAFFIC" | "BEST_ROUTE"
  inputHash    String

  inputs       Json
  prediction   Json

  modelVersion String
  confidence   Float?

  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([type, inputHash])
  @@index([type, expiresAt])
  @@map("ai_predictions")
}

// ------------------------------------------------------------
// MÉTRICAS DE USO AGREGADAS
// Rutas populares, horarios pico, etc.
// ------------------------------------------------------------

model UsageMetric {
  id         String   @id @default(uuid())

  metricType String                         // "ROUTE_USAGE" | "PEAK_HOUR" | "POPULAR_ORIGIN"
  scope      String                         // "DAILY" | "WEEKLY" | "MONTHLY"

  // Período
  periodStart DateTime
  periodEnd   DateTime

  // Datos agregados flexibles
  // { routeId: "abc", searches: 1234, completedTrips: 890, avgDuration: 25 }
  data       Json

  computedAt DateTime @default(now())

  @@index([metricType, periodStart])
  @@index([scope, periodStart])
  @@map("usage_metrics")
}

// ------------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------------

model AuditLog {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])

  action    AuditAction
  tableName String
  recordId  String
  oldData   Json?
  newData   Json?

  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([tableName, recordId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
